<?xml version="1.0" encoding="utf-8"?>
<!--
  工具栏遮罩（深色背景用）：顶栏背后的壁纸偏暗时压一层黑雾，
  配合白色标题/图标使用（见 ThemeHelper.applyToolbarContent）。
-->
