<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形图标底（Shizuku 风格）：白色实心圆 + 内边距，实际颜色由 backgroundTint 决定 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
    <padding
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp" />
</shape>
