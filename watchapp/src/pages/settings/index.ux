<template>
  <div class="page column">
    <div class="top row">
      <image class="back" src="/common/icons/back.png" onclick="back" />
      <text class="title">手表设置</text>
    </div>

    <scroll class="body" scroll-y="true">
      <!-- 基础设置：切换账号（原神/米游社多账号） -->
      <div class="card column">
        <text class="section">切换账号</text>
        <text class="item" for="{{ accountRows }}" tid="id" onclick="pickAccount($item.pos)"
              style="color: {{ $item.isCurrent ? '#3D7BFF' : '#BDBDBD' }}">{{ $item.text }}</text>
        <text class="item" onclick="followPhone"
              style="color: {{ defaultFollow ? '#3D7BFF' : '#BDBDBD' }}">跟随手机当前账号</text>
        <text class="hint">{{ accountHint }}</text>
        <text class="hint">点左上角返回便签页</text>
      </div>

      <!-- 关于作者 -->
      <div class="card column">
        <text class="section">关于作者</text>
        <text class="line">旅行便签 · 手表端</text>
        <text class="line">版本 {{ versionName }}</text>
        <text class="line">打包 {{ buildTime }}</text>
        <text class="line">作者 having5548</text>
        <text class="line">github.com/having5548</text>
      </div>
    </scroll>
  </div>
</template>

<style>
/* 页面根节点：不写死宽度、不带 padding、高度取可见区。
   根节点带 padding 或高度超出可见区时，框架会把整页当成可拖动/可滚动的容器，
   横竖滑都会把内容推走且不回弹（内边距交给 .top / .body） */
.page {
  flex-direction: column;
  height: 432px;
  padding: 0px;
  background-color: #0d0d0d;
  overflow: hidden;
}

.row {
  flex-direction: row;
}

.column {
  flex-direction: column;
}

.top {
  align-items: center;
  /* 上边距 30 也放这里；左 32 - 返回按钮的 -6 外边距 = 26，和下面卡片左边距对齐 */
  padding: 30px 26px 0px 32px;
}

/* 返回按钮：34 -> 54，做大好点中（点左上角箭头是本页唯一的返回方式） */
.back {
  width: 54px;
  height: 54px;
  margin-right: 14px;
  margin-left: -6px;
  opacity: 0.95;
}

.title {
  color: #ffffff;
  font-size: 25px;
  font-weight: bold;
}

.body {
  flex: 1;
  flex-direction: column;
  margin-top: 14px;
  padding: 0px 26px 24px;
}

.card {
  width: 100%;
  flex-direction: column;
  padding: 16px 20px;
  margin-bottom: 14px;
  background-color: #1c1c1e;
  border-radius: 28px;
}

.section {
  color: #8a8a8a;
  font-size: 19px;
  margin-bottom: 6px;
}

.item {
  font-size: 22px;
  text-align: center;
  padding: 7px 0px;
}

.hint {
  color: #616161;
  font-size: 17px;
  text-align: center;
  margin-top: 4px;
}

.line {
  color: #bdbdbd;
  font-size: 20px;
  padding: 3px 0px;
  text-align: center;
}
</style>

<script>
import file from "@system.file";
import router from "@system.router";
import { versionName, buildTime } from "../../common/buildinfo";

const CACHE_URI = "internal://files/note_cache.json";
const DEF_URI = "internal://files/note_default.json";
// 便签页当前显示的账号（和"默认"分开存，但这里点选时两份一起写，保证里外一致）
const SEL_URI = "internal://files/note_sel.json";
const MAX_ACCOUNTS = 5;

/**
 * 手表设置（二级页）：
 * - 切换账号：点一下立刻切换便签页显示的账号（同时记下"下次打开也用它"）
 * - 关于作者：版本、打包时间、作者信息
 */
export default {
  private: {
    accountRows: [],
    accountHint: "还没有同步过数据，先在便签页点刷新",
    defaultId: "",
    defaultFollow: true,
    versionName: versionName,
    buildTime: buildTime
  },

  onReady() {
    this.accountRows = [];
    this.loadDefault();
  },

  // ---------------- 默认显示用户 ----------------

  loadDefault() {
    try {
      file.readText({
        uri: DEF_URI,
        success: (data) => {
          if (data && data.text) {
            try {
              const d = JSON.parse(data.text);
              if (d && d.id) {
                this.defaultId = d.id;
                this.defaultFollow = false;
              }
            } catch (e) {}
          }
          this.loadAccounts();
        },
        fail: () => this.loadAccounts()
      });
    } catch (e) {
      this.loadAccounts();
    }
  },

  /** 账号来自便签页那份整包缓存（手机端给的 accounts 数组）。 */
  loadAccounts() {
    try {
      file.readText({
        uri: CACHE_URI,
        success: (data) => {
          if (!data || !data.text) return;
          let msg = null;
          try {
            msg = JSON.parse(data.text);
          } catch (e) {
            return;
          }
          if (!msg) return;
          const list = msg.accounts && msg.accounts.length
            ? msg.accounts.slice(0, MAX_ACCOUNTS)
            : (msg.type === "dailyNote" ? [msg] : []);
          // 跟随手机时"当前账号"就是缓存里的 active，指定时就是 defaultId
          const currentId = this.defaultFollow ? (msg.active || "") : this.defaultId;
          const rows = [];
          for (let i = 0; i < list.length; i++) {
            const a = list[i] || {};
            const isCurrent = !!a.id && a.id === currentId;
            rows.push({
              id: a.id || "i" + i,
              text: (a.label || "账号 " + (i + 1)) + (isCurrent ? "  ✓ 当前" : ""),
              pos: i,
              isCurrent: isCurrent
            });
          }
          this.accountRows = rows;
          this.accountHint = rows.length > 1
            ? "点一下即可切换，便签页会立刻显示这个账号"
            : "手机端只有这一个账号";
        },
        fail: () => {}
      });
    } catch (e) {}
  },

  /** 点某个账号：立刻切换便签页显示的账号，并记住下次打开也用它。 */
  pickAccount(pos) {
    const row = this.accountRows[pos];
    if (!row || !row.id) return;
    this.defaultId = row.id;
    this.defaultFollow = false;
    this.saveDefault(row.id);
    this.saveSelection(row.id);
    this.loadAccounts();
  },

  followPhone() {
    this.defaultId = "";
    this.defaultFollow = true;
    this.saveDefault("");
    this.saveSelection("");
    this.loadAccounts();
  },

  saveDefault(id) {
    try {
      file.writeText({
        uri: DEF_URI,
        text: JSON.stringify(id ? { id: id } : { follow: true }),
        success: () => {},
        fail: () => {}
      });
    } catch (e) {}
  },

  /** 同步写一份"当前显示的账号"，便签页返回时会重读它并立刻切过去。 */
  saveSelection(id) {
    try {
      file.writeText({
        uri: SEL_URI,
        text: JSON.stringify({ id: id || "" }),
        success: () => {},
        fail: () => {}
      });
    } catch (e) {}
  },

  /** 返回便签页：只认左上角返回箭头，本页不再接任何滑动（左右滑一律无动作）。 */
  back() {
    router.back();
  }
};
</script>
