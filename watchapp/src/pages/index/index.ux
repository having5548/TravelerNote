<template>
  <div class="page column" onswipe="onSwipe">
    <div class="top row">
      <div class="statusWrap row">
        <div class="dot" style="background-color: {{statusColor}}"></div>
        <text class="status">{{ statusText }}</text>
      </div>
      <div class="actions row">
        <!-- 刷新：立刻向手机端拉一次最新数据 -->
        <image class="iconBtn" src="/common/icons/refresh.png" onclick="onRefreshTap" />
        <!-- 设置：进入手表设置二级页 -->
        <image class="iconBtn" src="/common/icons/settings.png" onclick="openSettings" />
      </div>
    </div>

    <div class="card column" if="{{ hasNote }}">
      <div class="row item" for="{{ metrics }}" tid="key">
        <div class="iconBg" style="background-color: {{$item.color}}">
          <image class="iconImg" src="/common/icons/{{$item.icon}}.png" />
        </div>
        <div class="mid column">
          <text class="label">{{$item.label}}</text>
          <text class="value">{{$item.value}}</text>
        </div>
        <text class="extra" style="color: {{$item.color}}" if="{{$item.extra}}">{{$item.extra}}</text>
      </div>
      <!-- 多账号：这一行只显示"当前账号 + 位置"，切换靠上下滑动 -->
      <div class="acct row" if="{{ showSwitcher }}">
        <image class="acctIcon" src="/common/icons/swap.png" />
        <text class="acctName">{{ accountText }}</text>
      </div>
      <text class="updated" else>{{ updatedText }}</text>
    </div>

    <div class="empty column" else>
      <text class="hint">{{ emptyText }}</text>
      <text class="hint-sub" if="{{ !showSwitcher }}">点右上角刷新，或等手机端连接后自动获取</text>
      <div class="acct row" if="{{ showSwitcher }}">
        <image class="acctIcon" src="/common/icons/swap.png" />
        <text class="acctName">{{ accountText }}</text>
      </div>
    </div>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  width: 432px;
  height: 514px;
  padding: 30px 26px 24px;
  background-color: #0d0d0d;
}

.column {
  flex-direction: column;
}

.row {
  flex-direction: row;
}

.top {
  align-items: center;
  justify-content: space-between;
  padding: 0px 6px;
}

.statusWrap {
  align-items: center;
}

.dot {
  width: 14px;
  height: 14px;
  border-radius: 7px;
  margin-right: 10px;
}

.status {
  color: #9e9e9e;
  font-size: 22px;
}

/* 右上角：刷新 + 设置两个图标按钮 */
.actions {
  align-items: center;
}

.iconBtn {
  width: 36px;
  height: 36px;
  margin-left: 14px;
}

.card {
  margin-top: 16px;
  padding: 8px 22px;
  background-color: #1c1c1e;
  border-radius: 28px;
  flex: 1;
}

.item {
  align-items: center;
  padding: 17px 0px;
}

.iconBg {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  align-items: center;
  justify-content: center;
}

.iconImg {
  width: 30px;
  height: 30px;
}

.mid {
  flex: 1;
  margin-left: 18px;
}

.label {
  color: #9e9e9e;
  font-size: 21px;
}

.value {
  color: #ffffff;
  font-size: 29px;
  margin-top: 4px;
  font-weight: bold;
}

.extra {
  font-size: 20px;
  margin-left: 8px;
}

.updated {
  color: #616161;
  font-size: 18px;
  text-align: center;
  padding: 4px 0px 12px;
}

/* 多账号：只显示当前账号 + 位置，切换靠上下滑动（不额外占纵向空间） */
.acct {
  align-items: center;
  justify-content: center;
  padding: 0px 0px 8px;
}

.acctIcon {
  width: 26px;
  height: 26px;
  margin-right: 10px;
  opacity: 0.65;
}

.acctName {
  color: #bdbdbd;
  font-size: 21px;
  text-align: center;
}

.empty {
  margin-top: 16px;
  padding: 28px;
  background-color: #1c1c1e;
  border-radius: 28px;
  flex: 1;
  align-items: center;
  justify-content: center;
}

.hint {
  color: #ffffff;
  font-size: 26px;
  text-align: center;
}

.hint-sub {
  color: #8a8a8a;
  font-size: 20px;
  margin-top: 12px;
  text-align: center;
}

</style>

<script>
import interconnect from "@system.interconnect";
import file from "@system.file";
import prompt from "@system.prompt";
import router from "@system.router";
import { versionName, buildTime } from "../../common/buildinfo";

// 与手机端实时便签同一套强调色（values/colors.xml）
const C = {
  resin: "#3D7BFF",
  coin: "#E8A23A",
  task: "#22A06B",
  sign: "#8B5CF6",
  online: "#22A06B",
  offline: "#E8A23A",
  error: "#EF4444",
  idle: "#9E9E9E"
};

// 树脂每点恢复耗时（秒），与手机端 rec 口径一致
const RESIN_UNIT_SECONDS = 480;
const CACHE_URI = "internal://files/note_cache.json";
// 选中的账号单独存一个文件，和数据缓存分开（数据缓存整包覆盖，选择要独立保留）
const SEL_URI = "internal://files/note_sel.json";
// 手表设置里选的"默认显示用户"（不设则跟随手机当前账号）
const DEF_URI = "internal://files/note_default.json";
// 与手机端 WatchNoteSync.MAX_WATCH_ACCOUNTS 对齐
const MAX_ACCOUNTS = 5;
// 数据时效：距上次同步超过 4 小时，打开应用/重连时才自动向手机端拉一次
const AUTO_SYNC_MS = 4 * 60 * 60 * 1000;

export default {
  private: {
    statusText: "连接中…",
    statusColor: C.idle,
    hasNote: false,
    metrics: [],
    updatedText: "",
    emptyText: "等待手机同步…",
    versionName: versionName,
    buildTime: buildTime,
    // ---- 多账号（最多 5 个，与手机端同步；上下滑动切换） ----
    accounts: [],
    accountCount: 0,
    accountText: "",
    showSwitcher: false,
    selIndex: 0,
    selId: "",
    // 设置页选的默认显示用户：defaultId 为空表示跟随手机当前账号
    defaultId: "",
    defaultFollow: true
  },

  onReady() {
    this.rawMsg = null;
    this.wasFull = false;
    this.timer = null;
    this.liveData = false;
    this.payload = null;
    this.accounts = [];
    this.accountCount = 0;
    this.accountText = "";
    this.showSwitcher = false;
    this.selIndex = 0;
    this.selId = "";
    this.defaultId = "";
    this.defaultFollow = true;
    // 用户是否手动切过账号（手动切过就不再被"上次保存的选择"校正覆盖）
    this.userPicked = false;
    // 连接状态（刷新按钮要用）与"本次打开是否已经自动拉过"
    this.online = false;
    this.autoRequested = false;

    this.conn = interconnect.instance();
    this.conn.onopen = () => {
      if (this.$valid) {
        this.setOnline();
        // 重新连上手机：只在数据过期（超过 AUTO_SYNC_MS）时才自动拉一次
        this.maybeAutoRequest();
      }
    };
    this.conn.onmessage = (res) => {
      if (this.$valid) this.handleMessage(res.data);
    };
    this.conn.onerror = () => {
      if (this.$valid) this.goOffline("连接错误");
    };
    this.conn.onclose = () => {
      if (this.$valid) this.goOffline("未连接手机");
    };
    // 无轮询：仅启动时查一次状态，之后全部事件驱动（省 CPU / 省电）
    this.conn.getReadyState({
      success: (res) => {
        if (!this.$valid) return;
        if (res.status === 1) {
          this.setOnline();
          // 打开应用时：数据超过 AUTO_SYNC_MS 才自动向手机端拉一次
          this.maybeAutoRequest();
        } else {
          this.goOffline("未连接手机");
        }
      },
      fail: () => {}
    });
    // 启动时若无实时数据，先展示上次同步的缓存（先恢复默认账号/上次选中的账号）
    this.loadPrefs();
  },

  /** 从设置页返回时，可能改过"默认显示用户"：重读并按需切换。 */
  onShow() {
    this.refreshDefaultId();
  },

  setOnline() {
    this.online = true;
    this.statusColor = C.online;
    if (!this.liveData) this.statusText = "已连接手机";
  },

  /** 连接失败：有缓存就回退展示缓存数据，并启动本地推算。 */
  goOffline(text) {
    this.online = false;
    this.statusColor = this.rawMsg ? C.offline : C.error;
    this.statusText = this.rawMsg ? "离线 · 显示缓存数据" : text;
    this.startLiveTimer();
  },

  /**
   * 数据时效规则：距上次成功同步超过 4 小时才自动向手机端要一次
   * （打开应用、以及重新连上手机时各判断一次；手动刷新不受限制）。
   */
  maybeAutoRequest() {
    if (this.autoRequested || !this.online) return;
    const last = (this.payload && this.payload.ts) || 0;
    if (!last || Date.now() - last > AUTO_SYNC_MS) {
      this.autoRequested = true;
      this.requestNote();
    }
  },

  /** 手动刷新：不管数据新旧，立刻向手机端拉一次。 */
  onRefreshTap() {
    if (!this.online) {
      this.goOffline("未连接手机");
      return;
    }
    this.statusColor = C.idle;
    this.statusText = "获取中…";
    this.autoRequested = true;
    this.requestNote();
  },

  openSettings() {
    router.push({ uri: "/pages/settings" });
  },

  /** 只重读设置页写的默认显示用户，并按需切过去。 */
  refreshDefaultId() {
    try {
      file.readText({
        uri: DEF_URI,
        success: (data) => {
          let id = "";
          let follow = true;
          if (data && data.text) {
            try {
              const d = JSON.parse(data.text);
              if (d && d.id) {
                id = d.id;
                follow = false;
              }
            } catch (e) {}
          }
          if (id === this.defaultId && follow === this.defaultFollow) return;
          this.defaultId = id;
          this.defaultFollow = follow;
          if (!follow && id) this.applySavedSelection();
        },
        fail: () => {}
      });
    } catch (e) {}
  },

  handleMessage(raw) {
    let msg = null;
    try {
      msg = JSON.parse(raw);
    } catch (e) {
      return;
    }
    if (!msg) return;
    if (msg.type === "dailyNote") {
      this.statusColor = C.online;
      this.statusText = "已同步 · " + (msg.date || "");
      this.saveCache(msg);
      this.renderNote(msg);
    } else if (msg.action === "getStorageInfo") {
      this.replyStorage();
    }
  },

  // ---------------- 数据渲染（多账号） ----------------

  /**
   * 兼容两种载荷：
   * - v3：`accounts` 数组（最多 5 个，来自手机端多账号）
   * - v2：整条消息就是一个账号（老手机端）
   * 选中账号优先级：当前选中 → 上次保存的 → 手机端当前账号 → 第一个。
   * 注意：选择文件是异步读的，可能晚于手机推送到达，所以读完还会再校正一次
   * （见 [applySavedSelection]）。
   */
  renderNote(msg) {
    this.payload = msg;
    this.liveData = true;

    let list = [];
    if (msg.accounts && msg.accounts.length) {
      list = msg.accounts.slice(0, MAX_ACCOUNTS);
    } else {
      list = [msg];
    }
    this.accounts = list;
    this.accountCount = list.length;
    this.showSwitcher = list.length > 1;

    const byId = (id) => {
      if (!id) return -1;
      for (let i = 0; i < list.length; i++) {
        if (list[i].id === id) return i;
      }
      return -1;
    };
    const keep = this.selId || (list[this.selIndex] ? list[this.selIndex].id : "");
    let idx = byId(keep);
    if (idx < 0) idx = byId(msg.active);
    if (idx < 0) idx = 0;
    this.selIndex = idx;

    this.applyAccount();
    this.startLiveTimer();
  },

  /** 把当前选中账号的数据铺到卡片上（切换账号也走这里）。 */
  applyAccount() {
    const m = this.accounts[this.selIndex] || {};
    // 本地树脂推算与离线判断都基于"当前选中的账号"
    this.rawMsg = m;
    const list = [];
    if (m.resin) {
      list.push({
        key: "resin",
        icon: "resin",
        color: C.resin,
        label: "原粹树脂",
        value: m.resin.cur + " / " + m.resin.max,
        extra: ""
      });
    }
    if (m.coin) {
      list.push({
        key: "coin",
        icon: "home_coin",
        color: C.coin,
        label: "洞天宝钱",
        value: m.coin.cur + " / " + m.coin.max,
        extra: ""
      });
    }
    if (m.task) {
      list.push({
        key: "task",
        icon: "task",
        color: C.task,
        label: "每日委托",
        value: m.task.cur + " / " + m.task.total,
        extra: m.task.cur >= m.task.total && m.task.total > 0 ? "已完成" : ""
      });
    }
    if (m.sign) {
      list.push({
        key: "sign",
        icon: "sign",
        color: C.sign,
        label: "本月签到",
        value: m.sign.days + " 天",
        extra: m.sign.today ? "今日已签" : "今日未签"
      });
    }
    this.metrics = list;
    this.hasNote = list.length > 0;
    this.emptyText = m.error || (this.payload && this.payload.noteError) || "暂无便签数据";
    this.selId = m.id || "";
    this.accountText = (m.label || "账号") + " " + (this.selIndex + 1) + "/" + this.accountCount;
    this.refreshLiveResin();
  },

  // ---------------- 账号切换（上下滑动） ----------------

  /**
   * 上下滑动切换账号：上滑 = 下一个，下滑 = 上一个。
   * 切换结果只更新底部那一行（不弹窗，避免遮挡数据）。
   */
  onSwipe(evt) {
    const dir = evt && evt.direction;
    if (dir === "up") {
      this.nextAccount();
    } else if (dir === "down") {
      this.prevAccount();
    }
  },

  nextAccount() {
    this.switchTo(this.selIndex + 1);
  },

  prevAccount() {
    this.switchTo(this.selIndex - 1);
  },

  /** 环形切换；选中结果立刻落盘，重启或重新同步后仍停在同一个账号。 */
  switchTo(pos) {
    const n = this.accounts.length;
    if (n <= 1) return;
    const idx = ((pos % n) + n) % n;
    if (idx === this.selIndex) return;
    this.userPicked = true;
    this.selIndex = idx;
    this.saveSelection(this.accounts[idx].id);
    this.applyAccount();
  },

  /**
   * 选择文件读完后校正一次：若当前显示的不是上次保存的账号（例如手机推送先于文件读完到达），
   * 就切回去。用户已经手动切过（userPicked）则不干预。
   */
  applySavedSelection() {
    if (!this.selId || this.userPicked || this.accounts.length <= 1) return;
    for (let i = 0; i < this.accounts.length; i++) {
      if (this.accounts[i].id === this.selId && i !== this.selIndex) {
        this.selIndex = i;
        this.applyAccount();
        return;
      }
    }
  },

  /**
   * 按当前时间推算树脂进度与回满时刻（本地推算，断连也准确）：
   * 树脂每 RESIN_UNIT_SECONDS 秒回 1 点；回满时刻 = 手机取数时刻 ts + 剩余秒 rec。
   */
  refreshLiveResin() {
    const m = this.rawMsg;
    if (!m || !m.resin) {
      this.updatedText = "";
      return;
    }
    const now = Date.now();
    const elapsed = Math.max(0, Math.floor((now - (m.ts || now)) / 1000));
    const cur = Math.min(m.resin.max, m.resin.cur + Math.floor(elapsed / RESIN_UNIT_SECONDS));
    const full = cur >= m.resin.max;

    if (this.hasNote) {
      const rows = [];
      this.metrics.forEach((row) => {
        if (row.key === "resin") {
          rows.push(Object.assign({}, row, { value: cur + " / " + m.resin.max }));
        } else {
          rows.push(row);
        }
      });
      this.metrics = rows;
    }

    if (full) {
      const resinRow = this.metrics.filter((r) => r.key === "resin")[0];
      if (resinRow) {
        const rows = this.metrics.map((r) =>
          r.key === "resin" ? Object.assign({}, r, { extra: "已回满" }) : r
        );
        this.metrics = rows;
      }
      this.updatedText = "树脂已回满";
      if (!this.wasFull) {
        this.wasFull = true;
        prompt.showToast({ message: "原粹树脂已回满" });
      }
    } else {
      this.wasFull = false;
      const t = new Date((m.ts || now) + m.resin.rec * 1000);
      const pad = (n) => (n < 10 ? "0" + n : "" + n);
      const hhmm = pad(t.getHours()) + ":" + pad(t.getMinutes());
      if (this.hasNote) {
        const rows = this.metrics.map((r) =>
          r.key === "resin" ? Object.assign({}, r, { extra: "回满 " + hhmm }) : r
        );
        this.metrics = rows;
      }
      this.updatedText = "树脂回满 " + hhmm;
    }
  },

  /** 每分钟本地重算一次（仅在展示数据时运行；轻量，无网络请求）。 */
  startLiveTimer() {
    if (this.timer || !this.rawMsg) return;
    this.timer = setInterval(() => {
      if (this.$valid) this.refreshLiveResin();
    }, 60 * 1000);
  },

  // ---------------- 本地缓存 ----------------

  saveCache(msg) {
    try {
      file.writeText({
        uri: CACHE_URI,
        text: JSON.stringify(msg),
        success: () => {},
        fail: (err, code) => {
          console.log("saveCache fail: " + code);
        }
      });
    } catch (e) {}
  },

  loadCache() {
    try {
      file.readText({
        uri: CACHE_URI,
        success: (data) => {
          if (!this.$valid || this.liveData || !data || !data.text) return;
          try {
            const msg = JSON.parse(data.text);
            if (msg && msg.type === "dailyNote") {
              this.statusColor = C.offline;
              this.statusText = "离线 · 显示缓存数据";
              this.renderNote(msg);
            }
          } catch (e) {}
        },
        fail: () => {}
      });
    } catch (e) {}
  },

  /** 选中的账号 id 单独落盘（数据缓存整包覆盖，选择要独立保留）。 */
  saveSelection(id) {
    if (!id) return;
    try {
      file.writeText({
        uri: SEL_URI,
        text: JSON.stringify({ id: id }),
        success: () => {},
        fail: () => {}
      });
    } catch (e) {}
  },

  /** 默认显示用户（空字符串 = 跟随手机当前账号）。 */
  saveDefault(id) {
    try {
      file.writeText({
        uri: DEF_URI,
        text: JSON.stringify(id ? { id: id } : { follow: true }),
        success: () => {},
        fail: () => {}
      });
    } catch (e) {}
  },

  /**
   * 启动时读设置：先读「默认显示用户」，再读「上次选中」，最后读数据缓存。
   * 默认显示用户优先——它就是用来决定"打开手表应用时先看哪个号"的。
   */
  loadPrefs() {
    try {
      file.readText({
        uri: DEF_URI,
        success: (data) => {
          if (data && data.text) {
            try {
              const d = JSON.parse(data.text);
              if (d && d.id) {
                this.defaultId = d.id;
                this.defaultFollow = false;
              } else {
                this.defaultFollow = true;
              }
            } catch (e) {}
          }
          this.loadSelection();
        },
        fail: () => this.loadSelection()
      });
    } catch (e) {
      this.loadSelection();
    }
  },

  /** 恢复上次选中的账号（有默认显示用户时以默认为准），再读数据缓存。 */
  loadSelection() {
    try {
      file.readText({
        uri: SEL_URI,
        success: (data) => {
          if (data && data.text) {
            try {
              const s = JSON.parse(data.text);
              if (s && s.id) this.selId = s.id;
            } catch (e) {}
          }
          if (!this.defaultFollow && this.defaultId) this.selId = this.defaultId;
          this.applySavedSelection();
          this.loadCache();
        },
        fail: () => {
          if (!this.defaultFollow && this.defaultId) this.selId = this.defaultId;
          this.loadCache();
        }
      });
    } catch (e) {
      this.loadCache();
    }
  },

  // ---------------- 手机请求 ----------------

  requestNote() {
    if (!this.conn) return;
    this.conn.send({
      data: { action: "requestNote" },
      fail: (res) => {
        console.log("requestNote fail: " + JSON.stringify(res));
      }
    });
  },

  /** 手表应用信息回报：版本 + 构建时间 + 自身文件占用（files/cache 目录递归求和）。 */
  replyStorage() {
    if (!this.conn) return;
    let total = 0;
    let pending = 2;
    const done = () => {
      pending -= 1;
      if (pending === 0) {
        this.conn.send({
          data: {
            type: "storageInfo",
            versionName: this.versionName,
            buildTime: this.buildTime,
            usedKb: Math.round(total / 1024)
          },
          fail: () => {}
        });
      }
    };
    ["internal://files/", "internal://cache/"].forEach((root) => {
      try {
        file.get({
          uri: root,
          recursive: true,
          success: (d) => {
            try {
              (d.subFiles || []).forEach((f) => {
                total += f.length || 0;
              });
            } catch (e) {}
            done();
          },
          fail: () => done()
        });
      } catch (e) {
        done();
      }
    });
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
  }
};
</script>
