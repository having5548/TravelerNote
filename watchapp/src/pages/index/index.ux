<template>
  <!--
    页面根节点与内容层都**不绑任何手势**：账号切换已经搬到手表设置页，
    绑了手势反而容易被框架当成"可拖动/可滚动"的页面（横竖滑都会把内容推走且不回弹）。
  -->
  <div class="page column">
    <div class="content column">
      <div class="top row">
        <div class="statusWrap row">
          <div class="dot" style="background-color: {{statusColor}}"></div>
          <text class="status">{{ statusText }}</text>
        </div>
        <!-- 刷新：立刻向手机端拉一次最新数据；设置：进手表设置二级页。
             两个按钮同样大小、间距 20px，位置固定（状态文字变长也不会挤动它们） -->
        <image class="iconBtn" src="/common/icons/refresh.png" onclick="onRefreshTap" />
        <image class="iconBtn" src="/common/icons/settings.png" onclick="openSettings" />
      </div>

      <div class="card column" if="{{ hasNote }}">
        <div class="row item" for="{{ metrics }}" tid="key">
          <div class="iconBg" style="background-color: {{$item.color}}">
            <image class="iconImg" src="/common/icons/{{$item.icon}}.png" />
          </div>
          <div class="mid column">
            <text class="label">{{$item.label}}</text>
            <text class="value">{{$item.value}}</text>
          </div>
          <text class="extra" style="color: {{$item.color}}" if="{{$item.extra}}">{{$item.extra}}</text>
        </div>
        <!-- 多账号：只显示"当前账号 + 位置"（切换账号在手表设置页里） -->
        <div class="acct row" if="{{ showSwitcher }}">
          <text class="acctName">{{ accountText }}</text>
        </div>
        <text class="updated" else>{{ updatedText }}</text>
      </div>

      <div class="empty column" else>
        <text class="hint">{{ emptyText }}</text>
        <text class="hint-sub" if="{{ !showSwitcher }}">点右上角刷新，或等手机端连接后自动获取</text>
        <div class="acct row" if="{{ showSwitcher }}">
          <text class="acctName">{{ accountText }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
/*
 * 页面根节点：**既不带 padding、也不写死高度**。
 * 之前根节点有 padding 时，框架把"可滚动范围"算成 视口+padding，
 * 页面就变成可横/竖拖动的容器：滑一下内容被推走（横向正好等于水平 padding，
 * 纵向是 514 高度超出可见区那 82px）且松手不回弹。现在内边距全部交给 .content。
 * 高度取可见区（设计宽高一致 = 432），内容也压在这一屏里，竖着也拖不动。
 */
.page {
  flex-direction: column;
  height: 432px;
  background-color: #0d0d0d;
  overflow: hidden;
}

.column {
  flex-direction: column;
}

/* 内容层：手势全都不绑（账号切换在设置页），只负责内边距与纵向布局 */
.content {
  flex: 1;
  flex-direction: column;
  padding: 30px 26px 12px;
}

.row {
  flex-direction: row;
}

/*
 * 顶栏：状态区**固定宽度**，右边两个按钮才不会被状态文字挤来挤去
 * （之前用 flex:1 + space-between，Vela 里 flex 没按预期分配空间，
 *  结果状态文字一变长，两个按钮就左右跑）。
 */
.top {
  align-items: center;
  padding: 0px 6px;
}

.statusWrap {
  width: 232px;
  align-items: center;
}

.dot {
  width: 14px;
  height: 14px;
  border-radius: 7px;
  margin-right: 10px;
}

.status {
  color: #9e9e9e;
  font-size: 22px;
}

/* 刷新 / 设置按钮：两个**同样大小**（46px）、间距 20px，位置固定不随状态文字变化 */
.iconBtn {
  width: 46px;
  height: 46px;
  margin-left: 20px;
}

.card {
  margin-top: 16px;
  padding: 8px 22px;
  background-color: #1c1c1e;
  border-radius: 28px;
  flex: 1;
}

.item {
  align-items: center;
  /* 17 -> 14：圆屏可见高度只有约 432 设计像素，收紧一点给底部指示点腾位置 */
  padding: 14px 0px;
}

.iconBg {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  align-items: center;
  justify-content: center;
}

.iconImg {
  width: 30px;
  height: 30px;
}

.mid {
  flex: 1;
  margin-left: 18px;
}

.label {
  color: #9e9e9e;
  font-size: 21px;
}

.value {
  color: #ffffff;
  font-size: 29px;
  margin-top: 4px;
  font-weight: bold;
}

.extra {
  font-size: 20px;
  margin-left: 8px;
}

.updated {
  color: #616161;
  font-size: 18px;
  text-align: center;
  padding: 4px 0px 12px;
}

/* 多账号：只显示当前账号 + 位置（不再有上下箭头图标，切换账号在设置页里） */
.acct {
  align-items: center;
  justify-content: center;
  padding: 0px 0px 8px;
}

.acctName {
  color: #bdbdbd;
  font-size: 21px;
  text-align: center;
}

.empty {
  margin-top: 16px;
  padding: 28px;
  background-color: #1c1c1e;
  border-radius: 28px;
  flex: 1;
  align-items: center;
  justify-content: center;
}

.hint {
  color: #ffffff;
  font-size: 26px;
  text-align: center;
}

.hint-sub {
  color: #8a8a8a;
  font-size: 20px;
  margin-top: 12px;
  text-align: center;
}

</style>

<script>
import interconnect from "@system.interconnect";
import file from "@system.file";
import prompt from "@system.prompt";
import router from "@system.router";
import { versionName, buildTime } from "../../common/buildinfo";

// 与手机端实时便签同一套强调色（values/colors.xml）
const C = {
  resin: "#3D7BFF",
  coin: "#E8A23A",
  task: "#22A06B",
  sign: "#8B5CF6",
  online: "#22A06B",
  offline: "#E8A23A",
  error: "#EF4444",
  idle: "#9E9E9E"
};

// 树脂每点恢复耗时（秒），与手机端 rec 口径一致
const RESIN_UNIT_SECONDS = 480;
const CACHE_URI = "internal://files/note_cache.json";
// 选中的账号单独存一个文件，和数据缓存分开（数据缓存整包覆盖，选择要独立保留）
const SEL_URI = "internal://files/note_sel.json";
// 手表设置里选的"默认显示用户"（不设则跟随手机当前账号）
const DEF_URI = "internal://files/note_default.json";
// 与手机端 WatchNoteSync.MAX_WATCH_ACCOUNTS 对齐
const MAX_ACCOUNTS = 5;
// 数据时效：距上次同步超过 4 小时，打开应用/重连时才自动向手机端拉一次
const AUTO_SYNC_MS = 4 * 60 * 60 * 1000;

/**
 * 该账号没有这一项数据时的占位行：行数与行高和正常行完全一样，只把值写成 —，
 * 这样切账号时卡片高度不变（界面不会跳）。
 */
function PLACEHOLDER(key, icon, color, label) {
  return { key: key, icon: icon, color: color, label: label, value: "—", extra: "" };
}

export default {
  private: {
    statusText: "连接中…",
    statusColor: C.idle,
    hasNote: false,
    metrics: [],
    updatedText: "",
    emptyText: "等待手机同步…",
    versionName: versionName,
    buildTime: buildTime,
    // ---- 多账号（最多 5 个，与手机端同步；切换账号在手表设置页里） ----
    accounts: [],
    accountCount: 0,
    accountText: "",
    showSwitcher: false,
    selIndex: 0,
    selId: "",
    // 设置页选的默认显示用户：defaultId 为空表示跟随手机当前账号
    defaultId: "",
    defaultFollow: true
  },

  onReady() {
    this.rawMsg = null;
    this.wasFull = false;
    this.timer = null;
    this.liveData = false;
    this.payload = null;
    this.accounts = [];
    this.accountCount = 0;
    this.accountText = "";
    this.showSwitcher = false;
    this.selIndex = 0;
    this.selId = "";
    this.defaultId = "";
    this.defaultFollow = true;
    // 连接状态（刷新按钮要用）与"本次打开是否已经自动拉过"
    this.online = false;
    this.autoRequested = false;

    this.conn = interconnect.instance();
    this.conn.onopen = () => {
      if (this.$valid) {
        this.setOnline();
        // 重新连上手机：只在数据过期（超过 AUTO_SYNC_MS）时才自动拉一次
        this.maybeAutoRequest();
      }
    };
    this.conn.onmessage = (res) => {
      if (this.$valid) this.handleMessage(res.data);
    };
    this.conn.onerror = () => {
      if (this.$valid) this.goOffline("连接错误");
    };
    this.conn.onclose = () => {
      if (this.$valid) this.goOffline("未连接手机");
    };
    // 无轮询：仅启动时查一次状态，之后全部事件驱动（省 CPU / 省电）
    this.conn.getReadyState({
      success: (res) => {
        if (!this.$valid) return;
        if (res.status === 1) {
          this.setOnline();
          // 打开应用时：数据超过 AUTO_SYNC_MS 才自动向手机端拉一次
          this.maybeAutoRequest();
        } else {
          this.goOffline("未连接手机");
        }
      },
      fail: () => {}
    });
    // 启动时若无实时数据，先展示上次同步的缓存（先恢复设置页选的账号）
    this.loadPrefs();
  },

  /**
   * 从设置页返回时，重读设置页写的「当前账号」并**立刻切过去**。
   * 以前的 bug：这里只重读了默认账号、却拿旧的 selId 去套，于是在设置里换了账号，
   * 回到便签页显示的还是老账号。现在整份 prefs 重读一遍再应用。
   */
  onShow() {
    this.loadPrefs();
  },

  setOnline() {
    this.online = true;
    this.statusColor = C.online;
    if (!this.liveData) this.statusText = "已连接手机";
  },

  /** 连接失败：有缓存就回退展示缓存数据，并启动本地推算。 */
  goOffline(text) {
    this.online = false;
    this.statusColor = this.rawMsg ? C.offline : C.error;
    this.statusText = this.rawMsg ? "离线 · 缓存数据" : text;
    this.startLiveTimer();
  },

  /**
   * 数据时效规则：距上次成功同步超过 4 小时才自动向手机端要一次
   * （打开应用、以及重新连上手机时各判断一次；手动刷新不受限制）。
   */
  maybeAutoRequest() {
    if (this.autoRequested || !this.online) return;
    const last = (this.payload && this.payload.ts) || 0;
    if (!last || Date.now() - last > AUTO_SYNC_MS) {
      this.autoRequested = true;
      this.requestNote();
    }
  },

  /** 手动刷新：不管数据新旧，立刻向手机端拉一次。 */
  onRefreshTap() {
    if (!this.online) {
      this.goOffline("未连接手机");
      return;
    }
    this.statusColor = C.idle;
    this.statusText = "获取中…";
    this.autoRequested = true;
    this.requestNote();
  },

  openSettings() {
    router.push({ uri: "/pages/settings" });
  },

  handleMessage(raw) {
    let msg = null;
    try {
      msg = JSON.parse(raw);
    } catch (e) {
      return;
    }
    if (!msg) return;
    if (msg.type === "dailyNote") {
      this.statusColor = C.online;
      // 顶栏状态区宽度固定，文案要短（长文案会被裁掉）
      this.statusText = "已同步 " + String(msg.date || "").slice(5);
      this.saveCache(msg);
      this.renderNote(msg);
    } else if (msg.action === "getStorageInfo") {
      this.replyStorage();
    }
  },

  // ---------------- 数据渲染（多账号） ----------------

  /**
   * 兼容两种载荷：
   * - v3：`accounts` 数组（最多 5 个，来自手机端多账号）
   * - v2：整条消息就是一个账号（老手机端）
   * 选中账号优先级：当前选中 → 上次保存的 → 手机端当前账号 → 第一个。
   * 注意：选择文件是异步读的，可能晚于手机推送到达，所以读完还会再校正一次
   * （见 [applySavedSelection]）。
   */
  renderNote(msg) {
    this.payload = msg;
    this.liveData = true;

    let list = [];
    if (msg.accounts && msg.accounts.length) {
      list = msg.accounts.slice(0, MAX_ACCOUNTS);
    } else {
      list = [msg];
    }
    this.accounts = list;
    this.accountCount = list.length;
    this.showSwitcher = list.length > 1;

    const byId = (id) => {
      if (!id) return -1;
      for (let i = 0; i < list.length; i++) {
        if (list[i].id === id) return i;
      }
      return -1;
    };
    const keep = this.selId || (list[this.selIndex] ? list[this.selIndex].id : "");
    let idx = byId(keep);
    if (idx < 0) idx = byId(msg.active);
    if (idx < 0) idx = 0;
    this.selIndex = idx;

    this.applyAccount();
    this.startLiveTimer();
  },

  /** 把当前选中账号的数据铺到卡片上（切换账号也走这里）。 */
  applyAccount() {
    const m = this.accounts[this.selIndex] || {};
    // 本地树脂推算与离线判断都基于"当前选中的账号"
    this.rawMsg = m;
    // 固定四行：哪一项没数据也占位（值显示 —）。
    // 之前是按数据动态增减行，账号之间「洞天宝钱/本月签到」有无不同 -> 卡片忽高忽低，
    // 上下滑切账号时整块 UI 会跳，现在行数与行高恒定，界面钉死不跟着动。
    const list = [];
    list.push(
      m.resin
        ? {
            key: "resin",
            icon: "resin",
            color: C.resin,
            label: "原粹树脂",
            value: m.resin.cur + " / " + m.resin.max,
            extra: ""
          }
        : PLACEHOLDER("resin", "resin", C.resin, "原粹树脂")
    );
    list.push(
      m.coin
        ? {
            key: "coin",
            icon: "home_coin",
            color: C.coin,
            label: "洞天宝钱",
            value: m.coin.cur + " / " + m.coin.max,
            extra: ""
          }
        : PLACEHOLDER("coin", "home_coin", C.coin, "洞天宝钱")
    );
    list.push(
      m.task
        ? {
            key: "task",
            icon: "task",
            color: C.task,
            label: "每日委托",
            value: m.task.cur + " / " + m.task.total,
            extra: m.task.cur >= m.task.total && m.task.total > 0 ? "已完成" : ""
          }
        : PLACEHOLDER("task", "task", C.task, "每日委托")
    );
    list.push(
      m.sign
        ? {
            key: "sign",
            icon: "sign",
            color: C.sign,
            label: "本月签到",
            value: m.sign.days + " 天",
            extra: m.sign.today ? "今日已签" : "今日未签"
          }
        : PLACEHOLDER("sign", "sign", C.sign, "本月签到")
    );
    const has = !!(m.resin || m.coin || m.task || m.sign);
    this.metrics = list;
    this.hasNote = has;
    this.emptyText = m.error || (this.payload && this.payload.noteError) || "暂无便签数据";
    this.selId = m.id || "";
    this.accountText = (m.label || "账号") + " " + (this.selIndex + 1) + "/" + this.accountCount;
    this.refreshLiveResin();
  },

  /**
   * 选择文件读完后校正一次：若当前显示的不是保存的账号（例如手机推送先于文件读完到达），
   * 就切过去。切换账号现在只有设置页一个入口，所以这里一律以文件为准。
   */
  applySavedSelection() {
    if (!this.selId || this.accounts.length <= 1) return;
    for (let i = 0; i < this.accounts.length; i++) {
      if (this.accounts[i].id === this.selId && i !== this.selIndex) {
        this.selIndex = i;
        this.applyAccount();
        return;
      }
    }
  },

  /**
   * 按当前时间推算树脂进度与回满时刻（本地推算，断连也准确）：
   * 树脂每 RESIN_UNIT_SECONDS 秒回 1 点；回满时刻 = 手机取数时刻 ts + 剩余秒 rec。
   */
  refreshLiveResin() {
    const m = this.rawMsg;
    if (!m || !m.resin) {
      this.updatedText = "";
      return;
    }
    const now = Date.now();
    const elapsed = Math.max(0, Math.floor((now - (m.ts || now)) / 1000));
    const cur = Math.min(m.resin.max, m.resin.cur + Math.floor(elapsed / RESIN_UNIT_SECONDS));
    const full = cur >= m.resin.max;

    if (this.hasNote) {
      const rows = [];
      this.metrics.forEach((row) => {
        if (row.key === "resin") {
          rows.push(Object.assign({}, row, { value: cur + " / " + m.resin.max }));
        } else {
          rows.push(row);
        }
      });
      this.metrics = rows;
    }

    if (full) {
      const resinRow = this.metrics.filter((r) => r.key === "resin")[0];
      if (resinRow) {
        const rows = this.metrics.map((r) =>
          r.key === "resin" ? Object.assign({}, r, { extra: "已回满" }) : r
        );
        this.metrics = rows;
      }
      this.updatedText = "树脂已回满";
      if (!this.wasFull) {
        this.wasFull = true;
        prompt.showToast({ message: "原粹树脂已回满" });
      }
    } else {
      this.wasFull = false;
      const t = new Date((m.ts || now) + m.resin.rec * 1000);
      const pad = (n) => (n < 10 ? "0" + n : "" + n);
      const hhmm = pad(t.getHours()) + ":" + pad(t.getMinutes());
      if (this.hasNote) {
        const rows = this.metrics.map((r) =>
          r.key === "resin" ? Object.assign({}, r, { extra: "回满 " + hhmm }) : r
        );
        this.metrics = rows;
      }
      this.updatedText = "树脂回满 " + hhmm;
    }
  },

  /** 每分钟本地重算一次（仅在展示数据时运行；轻量，无网络请求）。 */
  startLiveTimer() {
    if (this.timer || !this.rawMsg) return;
    this.timer = setInterval(() => {
      if (this.$valid) this.refreshLiveResin();
    }, 60 * 1000);
  },

  // ---------------- 本地缓存 ----------------

  saveCache(msg) {
    try {
      file.writeText({
        uri: CACHE_URI,
        text: JSON.stringify(msg),
        success: () => {},
        fail: (err, code) => {
          console.log("saveCache fail: " + code);
        }
      });
    } catch (e) {}
  },

  loadCache() {
    try {
      file.readText({
        uri: CACHE_URI,
        success: (data) => {
          if (!this.$valid || this.liveData || !data || !data.text) return;
          try {
            const msg = JSON.parse(data.text);
            if (msg && msg.type === "dailyNote") {
              this.statusColor = C.offline;
              this.statusText = "离线 · 缓存数据";
              this.renderNote(msg);
            }
          } catch (e) {}
        },
        fail: () => {}
      });
    } catch (e) {}
  },

  /**
   * 启动/返回本页时读设置：先读「当前账号」（设置页写的 note_default.json），
   * 再读上次选中（note_sel.json），最后读数据缓存。
   */
  loadPrefs() {
    try {
      file.readText({
        uri: DEF_URI,
        success: (data) => {
          if (data && data.text) {
            try {
              const d = JSON.parse(data.text);
              if (d && d.id) {
                this.defaultId = d.id;
                this.defaultFollow = false;
              } else {
                this.defaultFollow = true;
              }
            } catch (e) {}
          }
          this.loadSelection();
        },
        fail: () => this.loadSelection()
      });
    } catch (e) {
      this.loadSelection();
    }
  },

  /** 读「设置页选的账号」（note_sel.json）：指定了就用它，选"跟随手机"就交回给手机当前账号。 */
  loadSelection() {
    try {
      file.readText({
        uri: SEL_URI,
        success: (data) => {
          let picked = "";
          if (data && data.text) {
            try {
              const s = JSON.parse(data.text);
              if (s && s.id) picked = s.id;
            } catch (e) {}
          }
          this.selId = picked;
          if (!this.defaultFollow && this.defaultId) this.selId = this.defaultId;
          this.applySavedSelection();
          this.loadCache();
        },
        fail: () => {
          this.selId = "";
          if (!this.defaultFollow && this.defaultId) this.selId = this.defaultId;
          this.loadCache();
        }
      });
    } catch (e) {
      this.loadCache();
    }
  },

  // ---------------- 手机请求 ----------------

  requestNote() {
    if (!this.conn) return;
    this.conn.send({
      data: { action: "requestNote" },
      fail: (res) => {
        console.log("requestNote fail: " + JSON.stringify(res));
      }
    });
  },

  /** 手表应用信息回报：版本 + 构建时间 + 自身文件占用（files/cache 目录递归求和）。 */
  replyStorage() {
    if (!this.conn) return;
    let total = 0;
    let pending = 2;
    const done = () => {
      pending -= 1;
      if (pending === 0) {
        this.conn.send({
          data: {
            type: "storageInfo",
            versionName: this.versionName,
            buildTime: this.buildTime,
            usedKb: Math.round(total / 1024)
          },
          fail: () => {}
        });
      }
    };
    ["internal://files/", "internal://cache/"].forEach((root) => {
      try {
        file.get({
          uri: root,
          recursive: true,
          success: (d) => {
            try {
              (d.subFiles || []).forEach((f) => {
                total += f.length || 0;
              });
            } catch (e) {}
            done();
          },
          fail: () => done()
        });
      } catch (e) {
        done();
      }
    });
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
  }
};
</script>
