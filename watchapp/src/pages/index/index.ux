<template>
  <div class="page column">
    <div class="top row">
      <div class="statusWrap row">
        <div class="dot" style="background-color: {{statusColor}}"></div>
        <text class="status">{{ statusText }}</text>
      </div>
      <text class="dots" onclick="toggleAbout">⋯</text>
    </div>

    <div class="card column" if="{{ hasNote }}">
      <div class="row item" for="{{ metrics }}" tid="key">
        <div class="iconBg" style="background-color: {{$item.color}}">
          <image class="iconImg" src="/common/icons/{{$item.icon}}.png" />
        </div>
        <div class="mid column">
          <text class="label">{{$item.label}}</text>
          <text class="value">{{$item.value}}</text>
        </div>
        <text class="extra" style="color: {{$item.color}}" if="{{$item.extra}}">{{$item.extra}}</text>
      </div>
      <!-- 多账号：底部这一行从"树脂回满"改成账号切换条（回满时刻仍然显示在树脂行右侧） -->
      <div class="acct row" if="{{ showSwitcher }}">
        <text class="acctNav" onclick="prevAccount">‹</text>
        <text class="acctName" onclick="nextAccount">{{ accountText }}</text>
        <text class="acctNav" onclick="nextAccount">›</text>
      </div>
      <text class="updated" else>{{ updatedText }}</text>
    </div>

    <div class="empty column" else>
      <text class="hint">{{ emptyText }}</text>
      <text class="hint-sub" if="{{ !showSwitcher }}">在手机 App「设置 → 手表同步」里发送</text>
      <div class="acct row" if="{{ showSwitcher }}">
        <text class="acctNav" onclick="prevAccount">‹</text>
        <text class="acctName" onclick="nextAccount">{{ accountText }}</text>
        <text class="acctNav" onclick="nextAccount">›</text>
      </div>
    </div>

    <div class="about" if="{{ showAbout }}" onclick="toggleAbout">
      <div class="about-card column">
        <text class="about-title">旅行便签 · 手表端</text>
        <div class="about-acct column" if="{{ showSwitcher }}">
          <text class="about-acct-title">账号（共 {{ accountCount }} 个，点按切换）</text>
          <text class="about-acct-item" for="{{ accountRows }}" tid="id" onclick="pickAccount($item.pos)"
                style="color: {{ $item.current ? '#3D7BFF' : '#BDBDBD' }}">{{ $item.text }}</text>
        </div>
        <text class="about-line">GitHub: having5548</text>
        <text class="about-line">版本 {{ versionName }}</text>
        <text class="about-line">构建 {{ buildTime }}</text>
        <text class="about-close">点击任意处关闭</text>
      </div>
    </div>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  width: 432px;
  height: 514px;
  padding: 30px 26px 24px;
  background-color: #0d0d0d;
}

.column {
  flex-direction: column;
}

.row {
  flex-direction: row;
}

.top {
  align-items: center;
  justify-content: space-between;
  padding: 0px 6px;
}

.statusWrap {
  align-items: center;
}

.dot {
  width: 14px;
  height: 14px;
  border-radius: 7px;
  margin-right: 10px;
}

.status {
  color: #9e9e9e;
  font-size: 22px;
}

.dots {
  color: #ffffff;
  font-size: 34px;
  padding: 0px 10px;
}

.card {
  margin-top: 16px;
  padding: 8px 22px;
  background-color: #1c1c1e;
  border-radius: 28px;
  flex: 1;
}

.item {
  align-items: center;
  padding: 17px 0px;
}

.iconBg {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  align-items: center;
  justify-content: center;
}

.iconImg {
  width: 30px;
  height: 30px;
}

.mid {
  flex: 1;
  margin-left: 18px;
}

.label {
  color: #9e9e9e;
  font-size: 21px;
}

.value {
  color: #ffffff;
  font-size: 29px;
  margin-top: 4px;
  font-weight: bold;
}

.extra {
  font-size: 20px;
  margin-left: 8px;
}

.updated {
  color: #616161;
  font-size: 18px;
  text-align: center;
  padding: 4px 0px 12px;
}

/* 多账号切换条：复用底部那行，不额外占纵向空间 */
.acct {
  align-items: center;
  justify-content: center;
  padding: 0px 0px 8px;
}

.acctNav {
  color: #8a8a8a;
  font-size: 26px;
  padding: 0px 20px;
}

.acctName {
  color: #bdbdbd;
  font-size: 21px;
  width: 240px;
  text-align: center;
}

.empty {
  margin-top: 16px;
  padding: 28px;
  background-color: #1c1c1e;
  border-radius: 28px;
  flex: 1;
  align-items: center;
  justify-content: center;
}

.hint {
  color: #ffffff;
  font-size: 26px;
  text-align: center;
}

.hint-sub {
  color: #8a8a8a;
  font-size: 20px;
  margin-top: 12px;
  text-align: center;
}

.about {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 432px;
  height: 514px;
  background-color: rgba(0, 0, 0, 0.72);
  align-items: center;
  justify-content: center;
}

.about-card {
  width: 340px;
  padding: 32px 28px;
  background-color: #1c1c1e;
  border-radius: 28px;
  align-items: center;
}

.about-title {
  color: #ffffff;
  font-size: 26px;
  margin-bottom: 14px;
}

.about-acct {
  width: 100%;
  margin-bottom: 6px;
}

.about-acct-title {
  color: #8a8a8a;
  font-size: 19px;
  text-align: center;
  margin-bottom: 4px;
}

.about-acct-item {
  font-size: 22px;
  text-align: center;
  padding: 5px 0px;
}

.about-line {
  color: #bdbdbd;
  font-size: 22px;
  margin-top: 8px;
}

.about-close {
  color: #616161;
  font-size: 18px;
  margin-top: 18px;
}
</style>

<script>
import interconnect from "@system.interconnect";
import file from "@system.file";
import prompt from "@system.prompt";
import { versionName, buildTime } from "../../common/buildinfo";

// 与手机端实时便签同一套强调色（values/colors.xml）
const C = {
  resin: "#3D7BFF",
  coin: "#E8A23A",
  task: "#22A06B",
  sign: "#8B5CF6",
  online: "#22A06B",
  offline: "#E8A23A",
  error: "#EF4444",
  idle: "#9E9E9E"
};

// 树脂每点恢复耗时（秒），与手机端 rec 口径一致
const RESIN_UNIT_SECONDS = 480;
const CACHE_URI = "internal://files/note_cache.json";
// 选中的账号单独存一个文件，和数据缓存分开（数据缓存整包覆盖，选择要独立保留）
const SEL_URI = "internal://files/note_sel.json";
// 与手机端 WatchNoteSync.MAX_WATCH_ACCOUNTS 对齐
const MAX_ACCOUNTS = 5;

export default {
  private: {
    statusText: "连接中…",
    statusColor: C.idle,
    hasNote: false,
    metrics: [],
    updatedText: "",
    emptyText: "等待手机同步…",
    showAbout: false,
    versionName: versionName,
    buildTime: buildTime,
    // ---- 多账号（最多 5 个，与手机端同步） ----
    accounts: [],
    accountRows: [],
    accountCount: 0,
    accountText: "",
    showSwitcher: false,
    selIndex: 0,
    selId: ""
  },

  onReady() {
    this.rawMsg = null;
    this.wasFull = false;
    this.timer = null;
    this.liveData = false;
    this.payload = null;
    this.accounts = [];
    this.accountRows = [];
    this.accountCount = 0;
    this.accountText = "";
    this.showSwitcher = false;
    this.selIndex = 0;
    this.selId = "";
    // 用户是否手动切过账号（手动切过就不再被"上次保存的选择"校正覆盖）
    this.userPicked = false;

    this.conn = interconnect.instance();
    this.conn.onopen = () => {
      if (this.$valid) {
        this.setOnline();
        this.requestNote();
      }
    };
    this.conn.onmessage = (res) => {
      if (this.$valid) this.handleMessage(res.data);
    };
    this.conn.onerror = () => {
      if (this.$valid) this.goOffline("连接错误");
    };
    this.conn.onclose = () => {
      if (this.$valid) this.goOffline("未连接手机");
    };
    // 无轮询：仅启动时查一次状态，之后全部事件驱动（省 CPU / 省电）
    this.conn.getReadyState({
      success: (res) => {
        if (!this.$valid) return;
        if (res.status === 1) {
          this.setOnline();
          this.requestNote();
        } else {
          this.goOffline("未连接手机");
        }
      },
      fail: () => {}
    });
    // 启动时若无实时数据，先展示上次同步的缓存（先恢复上次选中的账号）
    this.loadSelection();
  },

  setOnline() {
    this.statusColor = C.online;
    if (!this.liveData) this.statusText = "已连接手机";
  },

  /** 连接失败：有缓存就回退展示缓存数据，并启动本地推算。 */
  goOffline(text) {
    this.statusColor = this.rawMsg ? C.offline : C.error;
    this.statusText = this.rawMsg ? "离线 · 显示缓存数据" : text;
    this.startLiveTimer();
  },

  handleMessage(raw) {
    let msg = null;
    try {
      msg = JSON.parse(raw);
    } catch (e) {
      return;
    }
    if (!msg) return;
    if (msg.type === "dailyNote") {
      this.statusColor = C.online;
      this.statusText = "已同步 · " + (msg.date || "");
      this.saveCache(msg);
      this.renderNote(msg);
    } else if (msg.action === "getStorageInfo") {
      this.replyStorage();
    }
  },

  // ---------------- 数据渲染（多账号） ----------------

  /**
   * 兼容两种载荷：
   * - v3：`accounts` 数组（最多 5 个，来自手机端多账号）
   * - v2：整条消息就是一个账号（老手机端）
   * 选中账号优先级：当前选中 → 上次保存的 → 手机端当前账号 → 第一个。
   * 注意：选择文件是异步读的，可能晚于手机推送到达，所以读完还会再校正一次
   * （见 [applySavedSelection]）。
   */
  renderNote(msg) {
    this.payload = msg;
    this.liveData = true;

    let list = [];
    if (msg.accounts && msg.accounts.length) {
      list = msg.accounts.slice(0, MAX_ACCOUNTS);
    } else {
      list = [msg];
    }
    this.accounts = list;
    this.accountCount = list.length;
    this.showSwitcher = list.length > 1;

    const byId = (id) => {
      if (!id) return -1;
      for (let i = 0; i < list.length; i++) {
        if (list[i].id === id) return i;
      }
      return -1;
    };
    const keep = this.selId || (list[this.selIndex] ? list[this.selIndex].id : "");
    let idx = byId(keep);
    if (idx < 0) idx = byId(msg.active);
    if (idx < 0) idx = 0;
    this.selIndex = idx;

    this.applyAccount();
    this.startLiveTimer();
  },

  /** 把当前选中账号的数据铺到卡片上（切换账号也走这里）。 */
  applyAccount() {
    const m = this.accounts[this.selIndex] || {};
    // 本地树脂推算与离线判断都基于"当前选中的账号"
    this.rawMsg = m;
    const list = [];
    if (m.resin) {
      list.push({
        key: "resin",
        icon: "resin",
        color: C.resin,
        label: "原粹树脂",
        value: m.resin.cur + " / " + m.resin.max,
        extra: ""
      });
    }
    if (m.coin) {
      list.push({
        key: "coin",
        icon: "home_coin",
        color: C.coin,
        label: "洞天宝钱",
        value: m.coin.cur + " / " + m.coin.max,
        extra: ""
      });
    }
    if (m.task) {
      list.push({
        key: "task",
        icon: "task",
        color: C.task,
        label: "每日委托",
        value: m.task.cur + " / " + m.task.total,
        extra: m.task.cur >= m.task.total && m.task.total > 0 ? "已完成" : ""
      });
    }
    if (m.sign) {
      list.push({
        key: "sign",
        icon: "sign",
        color: C.sign,
        label: "本月签到",
        value: m.sign.days + " 天",
        extra: m.sign.today ? "今日已签" : "今日未签"
      });
    }
    this.metrics = list;
    this.hasNote = list.length > 0;
    this.emptyText = m.error || (this.payload && this.payload.noteError) || "暂无便签数据";
    this.selId = m.id || "";
    this.accountText = (m.label || "账号") + " " + (this.selIndex + 1) + "/" + this.accountCount;
    this.rebuildRows();
    this.refreshLiveResin();
  },

  /** ⋯ 浮层里的账号名册（当前账号高亮，点按切换）。 */
  rebuildRows() {
    const rows = [];
    for (let i = 0; i < this.accounts.length; i++) {
      const a = this.accounts[i] || {};
      rows.push({
        id: a.id || "i" + i,
        text: (a.label || "账号 " + (i + 1)) + (a.error ? "（" + a.error + "）" : ""),
        pos: i,
        current: i === this.selIndex
      });
    }
    this.accountRows = rows;
  },

  // ---------------- 账号切换 ----------------

  nextAccount() {
    this.switchTo(this.selIndex + 1);
  },

  prevAccount() {
    this.switchTo(this.selIndex - 1);
  },

  pickAccount(pos) {
    this.switchTo(pos);
    if (this.showAbout) this.showAbout = false;
  },

  /** 环形切换；选中结果立刻落盘，重启或重新同步后仍停在同一个账号。 */
  switchTo(pos) {
    const n = this.accounts.length;
    if (n <= 1) return;
    const idx = ((pos % n) + n) % n;
    if (idx === this.selIndex) return;
    this.userPicked = true;
    this.selIndex = idx;
    this.saveSelection(this.accounts[idx].id);
    this.applyAccount();
    prompt.showToast({ message: this.accountText });
  },

  /**
   * 选择文件读完后校正一次：若当前显示的不是上次保存的账号（例如手机推送先于文件读完到达），
   * 就切回去。用户已经手动切过（userPicked）则不干预。
   */
  applySavedSelection() {
    if (!this.selId || this.userPicked || this.accounts.length <= 1) return;
    for (let i = 0; i < this.accounts.length; i++) {
      if (this.accounts[i].id === this.selId && i !== this.selIndex) {
        this.selIndex = i;
        this.applyAccount();
        return;
      }
    }
  },

  /**
   * 按当前时间推算树脂进度与回满时刻（本地推算，断连也准确）：
   * 树脂每 RESIN_UNIT_SECONDS 秒回 1 点；回满时刻 = 手机取数时刻 ts + 剩余秒 rec。
   */
  refreshLiveResin() {
    const m = this.rawMsg;
    if (!m || !m.resin) {
      this.updatedText = "";
      return;
    }
    const now = Date.now();
    const elapsed = Math.max(0, Math.floor((now - (m.ts || now)) / 1000));
    const cur = Math.min(m.resin.max, m.resin.cur + Math.floor(elapsed / RESIN_UNIT_SECONDS));
    const full = cur >= m.resin.max;

    if (this.hasNote) {
      const rows = [];
      this.metrics.forEach((row) => {
        if (row.key === "resin") {
          rows.push(Object.assign({}, row, { value: cur + " / " + m.resin.max }));
        } else {
          rows.push(row);
        }
      });
      this.metrics = rows;
    }

    if (full) {
      const resinRow = this.metrics.filter((r) => r.key === "resin")[0];
      if (resinRow) {
        const rows = this.metrics.map((r) =>
          r.key === "resin" ? Object.assign({}, r, { extra: "已回满" }) : r
        );
        this.metrics = rows;
      }
      this.updatedText = "树脂已回满";
      if (!this.wasFull) {
        this.wasFull = true;
        prompt.showToast({ message: "原粹树脂已回满" });
      }
    } else {
      this.wasFull = false;
      const t = new Date((m.ts || now) + m.resin.rec * 1000);
      const pad = (n) => (n < 10 ? "0" + n : "" + n);
      const hhmm = pad(t.getHours()) + ":" + pad(t.getMinutes());
      if (this.hasNote) {
        const rows = this.metrics.map((r) =>
          r.key === "resin" ? Object.assign({}, r, { extra: "回满 " + hhmm }) : r
        );
        this.metrics = rows;
      }
      this.updatedText = "树脂回满 " + hhmm;
    }
  },

  /** 每分钟本地重算一次（仅在展示数据时运行；轻量，无网络请求）。 */
  startLiveTimer() {
    if (this.timer || !this.rawMsg) return;
    this.timer = setInterval(() => {
      if (this.$valid) this.refreshLiveResin();
    }, 60 * 1000);
  },

  // ---------------- 本地缓存 ----------------

  saveCache(msg) {
    try {
      file.writeText({
        uri: CACHE_URI,
        text: JSON.stringify(msg),
        success: () => {},
        fail: (err, code) => {
          console.log("saveCache fail: " + code);
        }
      });
    } catch (e) {}
  },

  loadCache() {
    try {
      file.readText({
        uri: CACHE_URI,
        success: (data) => {
          if (!this.$valid || this.liveData || !data || !data.text) return;
          try {
            const msg = JSON.parse(data.text);
            if (msg && msg.type === "dailyNote") {
              this.statusColor = C.offline;
              this.statusText = "离线 · 显示缓存数据";
              this.renderNote(msg);
            }
          } catch (e) {}
        },
        fail: () => {}
      });
    } catch (e) {}
  },

  /** 选中的账号 id 单独落盘（数据缓存整包覆盖，选择要独立保留）。 */
  saveSelection(id) {
    if (!id) return;
    try {
      file.writeText({
        uri: SEL_URI,
        text: JSON.stringify({ id: id }),
        success: () => {},
        fail: () => {}
      });
    } catch (e) {}
  },

  /** 先恢复上次选中的账号，再读数据缓存，保证缓存渲染出来的就是那个账号。 */
  loadSelection() {
    try {
      file.readText({
        uri: SEL_URI,
        success: (data) => {
          if (data && data.text) {
            try {
              const s = JSON.parse(data.text);
              if (s && s.id) this.selId = s.id;
            } catch (e) {}
          }
          this.applySavedSelection();
          this.loadCache();
        },
        fail: () => this.loadCache()
      });
    } catch (e) {
      this.loadCache();
    }
  },

  // ---------------- 手机请求 ----------------

  requestNote() {
    if (!this.conn) return;
    this.conn.send({
      data: { action: "requestNote" },
      fail: (res) => {
        console.log("requestNote fail: " + JSON.stringify(res));
      }
    });
  },

  /** 手表应用信息回报：版本 + 构建时间 + 自身文件占用（files/cache 目录递归求和）。 */
  replyStorage() {
    if (!this.conn) return;
    let total = 0;
    let pending = 2;
    const done = () => {
      pending -= 1;
      if (pending === 0) {
        this.conn.send({
          data: {
            type: "storageInfo",
            versionName: this.versionName,
            buildTime: this.buildTime,
            usedKb: Math.round(total / 1024)
          },
          fail: () => {}
        });
      }
    };
    ["internal://files/", "internal://cache/"].forEach((root) => {
      try {
        file.get({
          uri: root,
          recursive: true,
          success: (d) => {
            try {
              (d.subFiles || []).forEach((f) => {
                total += f.length || 0;
              });
            } catch (e) {}
            done();
          },
          fail: () => done()
        });
      } catch (e) {
        done();
      }
    });
  },

  toggleAbout() {
    this.showAbout = !this.showAbout;
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
  }
};
</script>
